      "easing": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "content": {
      "duration": 140,
      "easing": "ease-out"
    },
    "feedback": {
      "duration": 80,
      "easing": "ease-out"
    },
    "agentPanel": {
      "duration": 280,
      "easing": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "agentWaiting": {
      "duration": 1050,
      "easing": "linear"
    },
    "agentWaitingOut": {
      "duration": 90,
      "easing": "ease-out"
    },
    "reference": {
      "duration": 200,
      "easing": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "message": {
      "duration": 180,
      "easing": "ease-out"
    },
    "proposal": {
      "duration": 240,
      "easing": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "editFeedback": {
      "duration": 360,
      "easing": "ease-out"
    },
    "inputAvoidance": {
      "duration": 220,
      "easing": "ease-out"
    },
    "documentClose": {
      "duration": 620,
      "anticipation": 100,
      "settle": 180,
      "easing": "ease-in-out"
    }
  },
  "reducedMotion": {
    "duration": 0,
    "translation": 0,
    "scale": 1
  },
  "nativeMotionPolicy": "Prefer native control transitions; keep the same state relationships and interruption behavior. The durations above are shared implementation parameters, not Apple requirements."
